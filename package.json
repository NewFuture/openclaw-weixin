{
  "name": "openclaw-weixin",
  "version": "2.4.6",
  "description": "Community-maintained OpenClaw WeChat channel plugin",
  "license": "MIT",
  "author": "Tencent",
  "contributors": [
    "Contributors to NewFuture/openclaw-wechat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewFuture/openclaw-wechat.git"
  },
  "homepage": "https://github.com/NewFuture/openclaw-wechat#readme",
  "bugs": {
    "url": "https://github.com/NewFuture/openclaw-wechat/issues"
  },
  "keywords": [
    "openclaw",
    "wechat",
    "weixin",
    "channel",
    "plugin"
  ],
  "type": "module",
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "dist/",
    "README.md",
    "README.zh_CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:check": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.12"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.1.0",
    "openclaw": "2026.5.12",
    "silk-wasm": "^3.7.1",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "openclaw-weixin",
      "label": "WeChat",
      "selectionLabel": "WeChat",
      "docsPath": "/channels/openclaw-weixin",
      "docsLabel": "WeChat",
      "blurb": "Weixin channel",
      "order": 75
    },
    "install": {
      "npmSpec": "openclaw-weixin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12"
    }
  },
  "ilink_appid": "bot",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
